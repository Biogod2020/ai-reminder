%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#ffffff', 'primaryBorderColor': '#e9e9e7', 'lineColor': '#9b9b9b', 'fontFamily': 'sans-serif'}}}%%
graph TD
    classDef user focus fill:#2383e2,stroke:#1a65b0,stroke-width:2px,color:#fff,rx:8px,ry:8px;
    classDef node fill:#fff,stroke:#e9e9e7,stroke-width:2px,color:#37352f,rx:8px,ry:8px;
    classDef model fill:#fef3c7,stroke:#f59e0b,stroke-width:2px,color:#92400e,rx:8px,ry:8px,stroke-dasharray: 5 5;
    classDef db fill:#f3f4f6,stroke:#d1d5db,stroke-width:2px,color:#374151,rx:4px,ry:4px,shape:cylinder;
    classDef system fill:#eff6ff,stroke:#93c5fd,stroke-width:2px,color:#1e3a8a,rx:8px,ry:8px;

    %% Client Layer
    User[User Input / Dashboard]:::user

    %% Orchestrator Layer (LangGraph)
    subgraph "SoulOrchestrator (LangGraph State Machine)"
        Classify["classify (Node)"]:::node
        HandleTask["handle_task (Node)"]:::node
        HandleMemory["handle_memory (Node)"]:::node
        HandlePlanner["handle_planner (Node)"]:::node
        HandleClarify["handle_clarify (Node)"]:::node
        AwaitApproval["await_approval (Node)"]:::node
        Notify["notify (Node)"]:::node
        End((END)):::node

        Classify -- "intent=='task'" --> HandleTask
        Classify -- "intent=='memory'" --> HandleMemory
        Classify -- "intent=='planner'" --> HandlePlanner
        Classify -- "intent=='clarify'" --> HandleClarify
        
        HandleTask --> AwaitApproval
        HandlePlanner --> AwaitApproval
        HandleMemory --> Notify
        
        HandleClarify --> End
        AwaitApproval --> End
        Notify --> End
    end

    %% Perception & Memory Layer
    subgraph "Perception & Synthesis Pipeline"
        VisSampler["VisualSampler (15s Interval)"]:::system
        SysDB["KnowledgeDB (macOS CoreData)"]:::db
        SynEngine["BehaviorSynthesisEngine"]:::system
        GeminiVision{"Gemini 3.1 Flash-Lite (Vision)"}:::model
        TruthMerger["DualAxisMerger"]:::system
    end

    subgraph "Memory & Storage Layer"
        SqliteDB[("notion_soul.db (SQLite WAL)")]:::db
        MemConsol["MemoryConsolidator (Time-Pyramid)"]:::system
        UserSoul["user_soul.md (Global Context)"]:::db
    end

    %% Flow connections
    User -->|Natural Language| Classify
    
    VisSampler -->|Image Stream| SynEngine
    SysDB -->|App Timeline| SynEngine
    
    SynEngine -->|Batch of Frames| GeminiVision
    GeminiVision -->|Visual Intent JSON| TruthMerger
    SysDB -->|System Axis| TruthMerger
    TruthMerger -->|Merged Timeline| SqliteDB
    
    SqliteDB -->|Raw Logs| MemConsol
    MemConsol -->|Daily/Weekly Summaries| UserSoul
    
    UserSoul -.->|Context Injection| Classify
    UserSoul -.->|Context Injection| HandleTask
    
    HandleTask -.->|Write Subtasks| SqliteDB
    HandleMemory -.->|Write Fact| SqliteDB

    %% Click Interactions (Mapped to HTML IDs later)
    click Classify href "#node-classify" "View Classify Logic"
    click HandleTask href "#node-handle-task" "View Task Decomposition"
    click SynEngine href "#node-syn-engine" "View Synthesis Pipeline"
    click TruthMerger href "#node-truth-merger" "View Dual-Axis Merger"
    click MemConsol href "#node-mem-consol" "View Time-Pyramid Consolidation"
